<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/reservation.css">
    <link href='https://fonts.googleapis.com/css?family=Playfair' rel='stylesheet'>


    <title>All Reservation</title>
</head>
<body>


    <%- include('../templates/navBar.ejs'); -%>

    <div class="wrapper">

        <h1>All Reservation</h1>

            <% if(cancelReservation){ %>
            <p style="color: green;"><%= cancelReservation  %><p>         
            <% } else{} %>
                   

        <% if (locals.error) { %>
            <p style="color: red;"><%= error %></p>
        <% } else{ %>
            <% rows.forEach((rows) => { %>

                <div class="reservation-description">
                    <p><strong>Name: </strong><%= rows.username %></p>
                    <p><strong>Time: </strong> <%= rows.time %></p>
                    <p><strong>Total People: </strong> <%= rows.people %></p>
                    <p><strong>Date: </strong> <%= rows.date %></p>
                </div>
            
                <div class="form-container">
                    <form method="POST" action="/confirm-reservation">
                        <input type="hidden" id="reservation_id" name="reservation_id" value="<%= rows.reservation_id %>"> 
                        <button type="submit">Confirm</button>
                    </form>
                    <form method="POST" action="/cancel-reservation">
                    <input type="hidden" id="reservation_id" name="reservation_id" value="<%= rows.reservation_id %>"> 

                            <button type="submit">Cancel</button>
                    </form>
              </div>
              
            <% }) %>
        <% } %>

    </div>

  
    <%- include('../templates/footer.ejs'); -%>
    

</body>
</html>