<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Verified Reservation</h1>


     <% if (locals.error) { %>
        <p style="color: red;"><%= error %></p>
    <% } else{ %>
        <% rows.forEach((rows) => { %>

            <p><strong>Name: </strong><%= rows.username %></p>
            <p><strong>Time: </strong> <%= rows.time %></p>
            <p><strong>Total People: </strong> <%= rows.people %></p>
            <p><strong>Date: </strong> <%= rows.date %></p>

           <br>

        <% }) %>
    <% } %>
    
</body>
</html>