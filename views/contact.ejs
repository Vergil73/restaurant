<body>
    <%- include('templates/navBar.ejs'); -%>

    <div class="wrapper">
        <h1>Contact Us</h1>
            <img src="https://images.unsplash.com/photo-1549473448-5d7196c91f48?w=400&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTE0fHxtYW5hZ2VyfGVufDB8fDB8fHww" width="200" height="300">

